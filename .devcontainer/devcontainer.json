{
  "name": "Checklists de Manutenção",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user -r requirements.txt && python scripts/preparar_codespace.py",
  "postAttachCommand": "python scripts/preparar_codespace.py --iniciar",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "App de Checklists", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["COMO-TESTAR.md"] }
  }
}
